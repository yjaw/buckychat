# Shared
APP_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5174,http://localhost:5173

# Go backend
SERVER_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Optional only for legacy HS256 Supabase projects. Prefer JWKS/asymmetric signing keys.
SUPABASE_JWT_SECRET=
ADMIN_EMAILS=admin@wisc.edu
TURN_URLS=stun:stun.l.google.com:19302
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional Cloudflare Realtime TURN. If set, the backend generates short-lived ICE servers.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL=86400
# Development only: allows one account to test matching from two browsers.
ALLOW_SELF_MATCH=false

# React frontend
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional. Defaults to the current browser origin plus /auth/callback.
# VITE_AUTH_REDIRECT_URL=http://127.0.0.1:5174/auth/callback
# Optional. Defaults to the current browser origin plus /reset-password.
# Set this in production if Supabase should always redirect to a canonical host.
# VITE_PASSWORD_RESET_REDIRECT_URL=https://buckychat.com/reset-password
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
